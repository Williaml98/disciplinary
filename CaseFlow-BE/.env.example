# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# spring-dotenv loads it automatically on `./mvnw spring-boot:run`, so no IDE run-config or
# shell exports are needed.
#
# Defaults below point at the local Mailpit dev SMTP catcher (see docker-compose.yml),
# which needs no credentials and catches everything at http://localhost:8025 — good
# enough to leave .env absent entirely for local dev. To send through a real provider,
# create .env and override these with your actual SMTP host/credentials.

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=noreply@auca.ac.rw

# --- Sending through Gmail instead of Mailpit ---
# Gmail requires AUTH and STARTTLS on port 587, and rewrites the sender unless SMTP_FROM
# matches SMTP_USERNAME exactly. SMTP_PASSWORD must be a Google *App Password* (16 chars,
# generated at https://myaccount.google.com/apppasswords with 2FA enabled) — a normal
# account password is rejected. Uncomment and fill in your own .env:
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_FROM=you@gmail.com

# Where the frontend is reachable. Used only to build the call-to-action links in outgoing
# emails, so point it at the deployed frontend origin (not the API) outside local dev.
CASEFLOW_APP_URL=http://localhost:5173

# Directory evidence and profile-picture uploads are written to, relative to the backend's
# working directory unless absolute.
CASEFLOW_UPLOADS_DIR=uploads

# JWT signing secret for login tokens. A dev-only default is baked into application.yml
# so this also needs nothing set for local dev — but generate and set a real one
# (e.g. `openssl rand -base64 48`) before this goes anywhere beyond your machine.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720
JWT_REMEMBER_EXPIRATION_MINUTES=43200
