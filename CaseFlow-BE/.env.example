# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Defaults below point at the local Mailpit dev SMTP catcher (see docker-compose.yml),
# which needs no credentials and catches everything at http://localhost:8025 — good
# enough to leave .env absent entirely for local dev. To send through a real provider,
# create .env and override these with your actual SMTP host/credentials.

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=noreply@auca.ac.rw
